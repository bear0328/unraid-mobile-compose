# unRAID webGui GraphQL 上游,不带尾部斜杠。
UNRAID_UPSTREAM=http://192.168.1.100:8001
# 原生 App 与多设备预填使用的地址;不填则沿用 UNRAID_UPSTREAM。
UNRAID_SERVER_URL=http://192.168.1.100:8001
TZ=Asia/Shanghai

# dev/prod 共用同一份 Compose,由各自 .env 区分镜像、容器、端口和数据目录。
IMAGE_TAG=latest
CONTAINER_NAME=unraid-mobile
WEB_PORT=3999
APPDATA_DIR=/mnt/user/appdata/unraid-mobile
